# Sentry error tracking (https://sentry.io)
# Create a project at sentry.io, then set these in Vercel's Environment Variables.

# Public DSN used by both client and server SDKs (safe to expose in the browser).
NEXT_PUBLIC_SENTRY_DSN=

# Used only at build time to upload source maps. Do NOT expose to the browser.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# HubSpot (https://app-eu1.hubspot.com/service-keys/149079327)
# Server-side only — used by app/api/local-authorities-contact to create/update
# CRM contacts. Needs crm.objects.contacts.read + crm.objects.contacts.write.
HUBSPOT_ACCESS_TOKEN=

# Slack (https://api.slack.com/apps -> your app -> Incoming Webhooks)
# Server-side only — optional. When set, app/api/local-authorities-contact
# posts a message to this webhook's channel on every successful submission.
SLACK_WEBHOOK_URL=
